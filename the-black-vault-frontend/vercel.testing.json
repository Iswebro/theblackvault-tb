{
  "github": {
    "silent": true
  },
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "build",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Environment",
          "value": "testing"
        }
      ]
    }
  ]
}
